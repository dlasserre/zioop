{
  "name": "@zioop/ai-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:codex": "node --env-file-if-exists=.env dist/src/main.js --provider codex",
    "start:claude": "node --env-file-if-exists=.env dist/src/main.js --provider claude",
    "test": "npm run build && node --test dist/test/*.test.js",
    "history": "node dist/src/history-cli.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@openai/codex-sdk": "0.156.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
